    "def isPrime(n):\n",
    "    if n <=1:\n",
    "        return False\n",
    "    for i in range(2,n):\n",
    "        if n%i == 0:\n",
    "            return False\n",
    "    return True\n",
    "print(isPrime(10))\n",
    "    "
   ]
